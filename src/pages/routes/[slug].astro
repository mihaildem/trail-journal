---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((report) => ({ params: { slug: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
const { data } = report;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${data.title} — Тропа и контекст`} description={data.description}>
  <main class="wrap">
      <div class="crumbs"><a href={base}>Главная</a><span>/</span><a href={`${base}routes/`}>Маршруты</a><span>/</span>{data.region}</div>
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{data.region} · {data.date}</p>
        <h1>{data.title}</h1>
        <p class="dek">{data.description}</p>
        <p class="byline">Походный журнал · {data.format ?? 'Поход'}</p>
      </div>
      <img class="hero-image" src={`${base}${data.cover.replace(/^\//, '')}`} alt="Схема маршрута по Сванетии" />
    </header>
    <section class="stats" aria-label="Характеристики маршрута">
      <div><span>Расстояние</span><strong>{data.distanceKm} км</strong></div>
      <div><span>Набор высоты</span><strong>+{data.elevationGainM.toLocaleString('ru-RU')} м</strong></div>
      <div><span>Продолжительность</span><strong>{data.duration}</strong></div>
      <div><span>Сложность</span><strong>{data.difficulty}</strong></div>
    </section>
    <div class="article-layout">
      <aside class="toc">
        <p>В этом отчёте</p>
        <a href="#маршрут-в-цифрах">Маршрут в цифрах</a>
        <a href="#как-появился-маршрут">Как появился маршрут</a>
        <a href="#почему-пошёл-один">Почему пошёл один</a>
        <a href="#дневник-прохождения">Дневник прохождения</a>
        <a href="#когда-ехать">Когда ехать</a>
        <a href="#карта">Карта</a>
        <a href="#важное-замечание-о-безопасности">Безопасность</a>
      </aside>
      <article class="prose"><Content /></article>
    </div>
  </main>
</BaseLayout>

<style>
  .crumbs { padding: 24px 0 12px; color: var(--muted); font-size: 13px; }
  .crumbs a { text-decoration: none; }
  .crumbs span { padding: 0 9px; color: #9aa69d; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 390px; align-items: center; gap: 44px; padding: 22px 0 42px; }
  .eyebrow { color: var(--green); font-size: 11px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  h1, .prose :global(h2), .prose :global(h3) { font-family: var(--serif); font-weight: 500; letter-spacing: -.025em; }
  h1 { margin: 15px 0; font-size: clamp(38px, 5vw, 62px); line-height: 1.1; }
  .dek { color: #52635b; font-family: var(--serif); font-size: 19px; }
  .byline { color: var(--muted); font-size: 13px; }
  .hero-image { width: 100%; aspect-ratio: 1.35; object-fit: cover; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-bottom: 58px; background: var(--green); color: white; }
  .stats div { padding: 18px 22px; border-right: 1px solid #ffffff35; }
  .stats div:last-child { border: 0; }
  .stats span, .stats strong { display: block; }
  .stats span { color: #c8d8ce; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
  .stats strong { margin-top: 4px; font-family: var(--serif); font-size: 20px; font-weight: 500; }
  .article-layout { display: grid; grid-template-columns: 190px minmax(0, 710px); justify-content: center; gap: 58px; padding-bottom: 90px; }
  .toc { position: sticky; top: 20px; align-self: start; }
  .toc p { color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .toc a { display: block; padding: 5px 0 5px 11px; border-left: 1px solid var(--line); color: var(--muted); font-size: 12px; text-decoration: none; }
  .toc a:hover { border-left: 2px solid var(--rust); color: var(--green); }
  .prose { min-width: 0; color: #283a33; }
  .prose :global(p), .prose :global(li) { font-family: var(--serif); font-size: 17px; line-height: 1.8; }
  .prose :global(h2) { margin: 50px 0 15px; font-size: 32px; line-height: 1.2; scroll-margin-top: 20px; }
  .prose :global(h3) { margin: 30px 0 10px; font-size: 22px; }
  .prose :global(blockquote) { margin: 30px 0; padding: 8px 0 8px 22px; border-left: 3px solid var(--rust); color: var(--green); font-family: var(--serif); font-size: 22px; line-height: 1.55; }
  .prose :global(img) { width: 100%; height: auto; margin-top: 30px; }
  .prose :global(table) { width: 100%; margin: 24px 0; border-collapse: collapse; font-family: 'DM Sans', sans-serif; font-size: 13px; }
  .prose :global(th), .prose :global(td) { padding: 10px 7px; border-bottom: 1px solid var(--line); text-align: left; }
  .prose :global(th) { color: var(--muted); font-weight: 500; }
  .prose :global(iframe) { width: 100%; max-width: 100%; margin: 15px 0; border: 0; }
  .prose :global(a) { color: var(--green); }
  @media (max-width: 800px) { .hero { grid-template-columns: minmax(0, 1fr) 300px; gap: 24px; } .article-layout { grid-template-columns: 155px minmax(0, 1fr); gap: 28px; } .stats div { padding: 15px; } }
  @media (max-width: 650px) {
    .hero { display: flex; flex-direction: column-reverse; align-items: stretch; gap: 18px; padding-bottom: 28px; }
    .hero-image { aspect-ratio: 1.55; }
    .stats { grid-template-columns: repeat(2, 1fr); margin-bottom: 38px; }
    .stats div:nth-child(2) { border-right: 0; }
    .article-layout { display: block; padding-bottom: 58px; }
    .toc { position: static; margin-bottom: 32px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
    .toc a { display: inline-block; margin: 0 9px 5px 0; padding: 4px 0; border: 0; }
    .prose :global(p), .prose :global(li) { font-size: 16px; }
    .prose :global(h2) { margin-top: 40px; font-size: 29px; }
  }
</style>
